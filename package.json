{
  "name": "@inbrace-tech/tokenline",
  "version": "1.2.4",
  "description": "A cache-aware statusline for AI coding CLIs — installs tokenline.sh and wires it into your Claude Code settings.",
  "bin": {
    "tokenline": "dist/cli.js"
  },
  "files": [
    "dist",
    "tokenline.sh"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "audit:lockfile": "node --experimental-strip-types scripts/check-lockfile-release-age.mts",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "changeset:check": "node --experimental-strip-types scripts/check-changeset-size.mts",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "claude-code",
    "antigravity",
    "statusline",
    "tokens",
    "prompt-cache",
    "cli"
  ],
  "author": "Inbrace (https://inbrace.com.br)",
  "contributors": [
    "Rodrigo Pinheiro Dias (https://github.com/ropdias)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/inbrace-tech/tokenline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inbrace-tech/tokenline.git"
  },
  "bugs": {
    "url": "https://github.com/inbrace-tech/tokenline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
